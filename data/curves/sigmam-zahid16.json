    {
      "id": "zahid16.sdss.sigmam.fit",
      "source": "Zahid et al. 2016 (SDSS)",
      "run": "SDSS DR12 quiescent, broken power-law fit",
      "kind": "observation",
      "relation": "sigmam",
      "epoch": {
        "zRepresentative": 0.11,
        "zNominal": 0.11,
        "zMin": 0.02,
        "zMax": 0.2,
        "mode": "observational-bin",
        "snapshot": null
      },
      "axes": {
        "xDefinition": "log10 stellar mass (SED fit, Chabrier IMF)",
        "xUnit": "log10(Msun)",
        "yDefinition": "log10 central line-of-sight stellar velocity dispersion (fibre, corrected to a 3 kpc aperture)",
        "yUnit": "log10(km/s)"
      },
      "domain": {
        "xMin": 9.362,
        "xMax": 11.656
      },
      "representation": {
        "type": "parametric",
        "equation": "log sigma = log sigma_b + alpha*(log M - log Mb), alpha = alpha1 (M<=Mb), alpha2 (M>Mb)",
        "expression": "logSigb+(x<=logMb?alpha1:alpha2)*(x-logMb)",
        "parameters": {
          "logMb": 10.26,
          "logSigb": 2.073,
          "alpha1": 0.403,
          "alpha2": 0.293
        }
      },
      "scatter": null,
      "selection": {
        "population": "quiescent (Dn4000>1.5), median log sigma in equally populated mass bins",
        "warning": "Domain = extent of the best-fit line plotted in Fig. 5 (log M* 9.36-11.66); the paper fits all bins. Quiescent galaxies only (SDSS: M*>1e9 Msun, 0.02<z<0.2, Dn4000>1.5; SHELS: R<20.6, M*>10^9.5 Msun, Dn4000>1.5). The relation is for the median log sigma in equally populated stellar-mass bins, so it is not a relation for star-forming/disc galaxies, whose stellar kinematics are partly ordered rotation. Stellar masses are 0.13 dex below the Portsmouth Kroupa passive masses (paper footnote). zRepresentative is the midpoint of the 0.02<z<0.2 selection, not a median."
      },
      "definitions": {
        "sigmaDefinition": "central LOS stellar velocity dispersion measured from stellar absorption lines through circular fibre apertures centred on each galaxy, corrected with sigma_SDSS/sigma_HECTO = (R_SDSS/R_HECTO)^beta, beta=-0.033, to a fiducial physical aperture of 3 kpc (revised.tex lines 84, 110, 120)",
        "massDefinition": "sed-total",
        "imf": "chabrier03",
        "cosmology": "unspecified",
        "population": "quiescent (Dn4000>1.5)",
        "sigmaDimension": "1D line of sight, central fibre aperture",
        "sigmaWeighting": "unspecified (spectrum-weighted, i.e. light; not stated in the paper)"
      },
      "provenance": {
        "tier": "published-fit",
        "citation": "Zahid et al. 2016, ApJ 832, 203 (arXiv:1607.04275), Table 'Fit Parameters' row SDSS (N=371884)",
