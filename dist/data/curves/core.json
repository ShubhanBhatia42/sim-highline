      "id": "speagle14.sfms.evolution",
      "source": "Speagle et al. 2014",
      "run": null,
      "kind": "observation",
      "relation": "sfms",
      "epoch": {
        "zRepresentative": 0,
        "zMin": 0,
        "zMax": 6,
        "mode": "analytic-evolution",
        "snapshot": null
      },
      "axes": {
        "xDefinition": "log10 stellar mass, Kroupa IMF",
        "xUnit": "log10(Msun)",
        "yDefinition": "log10 star-formation rate",
        "yUnit": "log10(Msun/yr)"
      },
      "domain": {
        "xMin": 9,
        "xMax": 11.5
      },
      "representation": {
        "type": "parametric",
        "equation": "y=(0.84-0.026*t)*x-(6.51-0.11*t)",
        "parameters": {
          "cosmicAgeGyr": "computed at selected redshift"
        },
        "expression": "(0.84-0.026*t)*x-(6.51-0.11*t)",
        "ageCosmology": {
          "H0": 70,
          "Om": 0.3
        }
      },
      "scatter": {
        "value": 0.2,
        "unit": "dex",
        "meaning": "approximate inter-study-corrected scatter"
      },
      "selection": {
        "population": "star-forming",
        "warning": "Compilation combines heterogeneous SFR indicators and effective timescales."
      },
      "provenance": {
        "tier": "published-fit",
        "citation": "Speagle et al. 2014, ApJS 214, 15",
        "doi": "10.1088/0067-0049/214/2/15",
        "url": "https://arxiv.org/abs/1405.2041",
        "retrieved": "2026-09-30"
      },
      "calibration": "validation",
      "rankable": true,
      "notes": "Analytic redshift evolution; display the equation rather than interpolating unrelated epoch curves.",
      "definitions": {
        "massDefinition": "sed-total",
        "imf": "kroupa01",
        "cosmology": {
          "H0": 70,
          "Om": 0.3
        },
        "population": "star-forming",
        "sfrTimescaleMyr": "heterogeneous",
        "sfrStatistic": "unspecified"
      }
    },
