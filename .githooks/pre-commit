#!/usr/bin/env bash
# Install once with: git config core.hooksPath .githooks
# Fast checks only (a few seconds): every JSON file parses, every script parses, no stray conflict markers, no large untracked-by-design files.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
if echo "$staged" | grep -q '\.json$'; then
  for f in $(echo "$staged" | grep '\.json$'); do python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" || { echo "pre-commit: $f is not valid JSON"; exit 1; }; done
fi
for f in $(echo "$staged" | grep -E '\.(mjs|js)$' || true); do
  case "$f" in data/curve-index.js) continue;; esac
  node --check "$f" 2>/dev/null || node --input-type=module --check < "$f" || { echo "pre-commit: $f does not parse"; exit 1; }
done
for f in $(echo "$staged" | grep '\.py$' || true); do python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$f" || { echo "pre-commit: $f does not compile"; exit 1; }; done
if git diff --cached -U0 | grep -qE '^\+(<<<<<<<|>>>>>>>)'; then echo "pre-commit: conflict markers staged"; exit 1; fi
big=$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 12000000 ] && echo "$f"; done)
[ -n "$big" ] && { echo "pre-commit: files over 12 MB staged: $big"; exit 1; }
exit 0
